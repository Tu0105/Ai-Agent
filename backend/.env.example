# 环境变量配置
# 复制此文件为 .env 并填入实际值

# OpenAI API Key (必需)
OPENAI_API_KEY=your-openai-api-key-here

# 可选配置
OPENAI_MODEL=gpt-3.5-turbo
TEMPERATURE=0.7
MAX_TOKENS=2000

# Comma-separated browser origins. Never use * when credentials are enabled.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Bound in-process state for long-running service instances.
AGENT_CACHE_MAX_SIZE=100
AGENT_CACHE_TTL_SECONDS=1800
MEMORY_CACHE_MAX_CONVERSATIONS=100
MEMORY_MAX_MESSAGES=100
